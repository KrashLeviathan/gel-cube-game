# Cache rules for the Cloudflare Worker's static assets.
#
# Vite copies public/ verbatim into dist/, which wrangler.toml hands to the
# Worker as its asset directory, so this file ships as-is. Cloudflare applies
# the rules and never serves the file itself.
#
# Workers' default for every asset is `public, max-age=0, must-revalidate`,
# and the entry document goes out without an ETag to revalidate against —
# which is why a browser could keep replaying an old index.html (and with it
# the old hashed bundle names) across a deploy until someone hard-refreshed.

# The entry document is the only unhashed file we ship, and it is what names
# the current build's bundles. It must never come out of a cache.
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

# Vite content-hashes these, so a new build is a new URL and the old one is
# simply never requested again. Caching them forever is safe, and it drops a
# revalidation round-trip per file on a phone.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
